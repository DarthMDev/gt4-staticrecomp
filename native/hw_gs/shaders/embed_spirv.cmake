# SPDX-License-Identifier: MIT
#
# Embeds one SPIR-V binary as a C++ array of 32-bit words (TASK-027, M4, IN-201).
# Usage: cmake -DSPV=<in.spv> -DCPP=<out.cpp> -DSYMBOL=<name> -P embed_spirv.cmake
# Copyright (c) 2026 GT4Recomp contributors.

if(NOT DEFINED SPV OR NOT DEFINED CPP OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "embed_spirv.cmake needs SPV, CPP and SYMBOL")
endif()

file(SIZE "${SPV}" spv_bytes)
math(EXPR spv_remainder "${spv_bytes} % 4")
if(NOT spv_remainder EQUAL 0)
    message(FATAL_ERROR "${SPV} is not a whole number of 32-bit words")
endif()

# file(READ HEX) yields two hex digits per byte in file order. SPIR-V words are little endian,
# so each group of four bytes b0 b1 b2 b3 becomes the word 0xb3b2b1b0.
file(READ "${SPV}" spv_hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])"
       "0x\\4\\3\\2\\1, " spv_words "${spv_hex}")
string(LENGTH "${spv_hex}" spv_hex_length)
math(EXPR word_count "${spv_hex_length} / 8")

file(WRITE "${CPP}"
"// Generated by embed_spirv.cmake from ${SPV}. Do not edit.\n"
"// SPDX-License-Identifier: MIT\n"
"#include <cstddef>\n"
"#include <cstdint>\n"
"\n"
"namespace hwgs::shaders {\n"
"extern const std::uint32_t ${SYMBOL}_words[${word_count}] = {\n${spv_words}\n};\n"
"extern const std::size_t ${SYMBOL}_word_count = ${word_count};\n"
"}  // namespace hwgs::shaders\n")
